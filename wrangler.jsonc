{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webapp",
  "compatibility_date": "2026-07-30",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "srm-droids-coe-prod",
      "database_id": "srm-droids-coe-prod-id"
    }
  ]
{
  "name": "droidscoe",
  "main": "src/index.ts"  // ← path to your Worker entry file
}
}
